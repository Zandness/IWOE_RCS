# Copy this file to .env in the backend folder for a new setup.
# Existing environment variables take precedence over .env.
# Restart the backend after changing configuration.

# MOCK: simulate bridge tasks without contacting the physical RCS.
# HIK: connect to the configured RCS controller.
RCS_MODE=MOCK

# Example controller address. Confirm the IP, port and path on site.
HIK_RCS_BASE_URL=http://192.168.200.101/rcs/rtas/api/robot/controller

HIK_RCS_API_VERSION=v1.0
HIK_RCS_TIMEOUT_SECONDS=30

# Used only when POST /api/rcs/tasks receives taskType=TRANSPORT.
# Set this to a task template installed in your RCS.
# Explicit task types, such as CTUB1, are sent as provided.
# Leave empty if every request specifies its actual RCS task type.
HIK_TASK_TYPE=