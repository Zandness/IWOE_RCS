# Default is safe MOCK mode. No request is sent to HIK RCS.
RCS_MODE=MOCK

# RCS 4.3 controller gateway used by the senior reference project.
# Confirm this URL on the target installation before changing RCS_MODE=HIK.
HIK_RCS_BASE_URL=http://192.168.100.101/rcs/rtas/api/robot/controller
HIK_RCS_API_VERSION=v1.0
HIK_RCS_TIMEOUT_SECONDS=30
