# Copy to .env in this backend folder. Existing environment variables take precedence.
RCS_MODE=MOCK
HIK_RCS_BASE_URL=http://192.168.100.101/rcs/rtas/api/robot/controller
HIK_RCS_API_VERSION=v1.0
HIK_RCS_TIMEOUT_SECONDS=30

# Used only when /api/rcs/tasks receives the generic WMS taskType TRANSPORT.
# Set to a task template installed in your RCS. Example task types:
# CTU: CTUW / LMR: F05 / FMR: F115 / QF: F116
# Leave empty until you choose the correct robot/task workflow.
HIK_TASK_TYPE=
